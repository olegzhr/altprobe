{
  "index_patterns": [
    "otel-v1-traces*"
  ],
  "priority": 120,
  "template": {
    "settings": {
      "index.default_pipeline": "altprobe-otel-spans",
      "number_of_shards": 1,
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "span": {
          "properties": {
            "trace_id": {
              "type": "keyword"
            },
            "span_id": {
              "type": "keyword"
            },
            "parent_span_id": {
              "type": "keyword"
            },
            "name": {
              "type": "keyword"
            },
            "kind": {
              "type": "keyword"
            },
            "service_name": {
              "type": "keyword"
            },
            "asset": {
              "type": "keyword"
            },
            "project_id": {
              "type": "keyword"
            },
            "source": {
              "type": "keyword"
            },
            "http_method": {
              "type": "keyword"
            },
            "http_url": {
              "type": "keyword"
            },
            "agent_key": {
              "type": "keyword"
            },
            "status": {
              "type": "keyword"
            },
            "duration_ms": {
              "type": "double"
            },
            "http_status": {
              "type": "integer"
            },
            "error": {
              "type": "boolean"
            }
          }
        },
        "resourceSpans": {
          "type": "object",
          "enabled": false
        }
      }
    }
  }
}
