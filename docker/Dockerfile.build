ARG BASE_IMAGE=ubuntu:22.04
FROM ${BASE_IMAGE}

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake pkg-config python3 dpkg-dev curl ca-certificates \
    libboost-all-dev libhiredis-dev libyaml-cpp-dev \
    libmodsecurity-dev libssl-dev libdaemon-dev zlib1g-dev \
    protobuf-compiler protobuf-compiler-grpc libgrpc++-dev libprotobuf-dev \
 && rm -rf /var/lib/apt/lists/*

ARG BUILD_JOBS=2
WORKDIR /work
COPY CMakeLists.txt /work/
COPY src/ /work/src/

RUN bash src/scripts/build.sh build --jobs "$BUILD_JOBS" \
 && bash src/scripts/build.sh test
